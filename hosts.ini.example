[servers]

worker-node-1 ansible_user=ec2-user
worker-node-2 ansible_user=ec2-user

worker-node-1 ansible_host=WORKER_NODE_1_IP
worker-node-2 ansible_host=WORKER_NODE_2_IP

[all:vars]

ansible_ssh_private_key_file=/home/ec2-user/ansible-master
ansible_python_interpreter=/usr/bin/python3
ansible_host_key_checking=false

